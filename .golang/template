package main

import (
	"bufio"
	"fmt"
	"os"
)

var in = bufio.NewReader(os.Stdin)
var out = bufio.NewWriter(os.Stdout)

func read(args ...any){
	fmt.Fscan(in,args...);
}
func ps(args ...any){
	fmt.Fprintln(out,args...);
}
var _ = ps;
func solve() {

}

func main() {
	defer out.Flush();
	var t int
	read(&t);
	for ; t > 0; t-- {
		solve()
	}
}
